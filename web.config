<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- 1. 告訴 IIS，凡是遇到 server.js，就交給 iisnode 模組處理 -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- 2. 排除靜態資源（如 public 資料夾下的 CSS、JS、圖片），讓 IIS 直接高效發送，不打擾 Node.js -->
        <rule name="StaticContent">
          <action type="None" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <match url=".*" />
        </rule>

        <!-- 3. 除了靜態資源，其餘所有的 URL 請求（如 API、後台路由等）通通重寫導入 server.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- 4. 安全設定：防止外界直接瀏覽 node_modules 等敏感資料夾 -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin"/>
          <add segment="node_modules" />
          <add segment="config" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- 5. 偵錯設定：當 Node.js 報錯時，直接在瀏覽器顯示詳細錯誤（測試環境極度實用） -->
    <iisnode devErrorsEnabled="true" logDirectory="iisnode" />
  </system.webServer>
</configuration>
